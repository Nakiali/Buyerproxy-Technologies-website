rules_version = '2';

// BuyerProxy Technologies — production-oriented Firestore rules
// Data paths:
//   bp_data/collections/users/{uid}
//   bp_data/collections/usernames/{username}
//   bp_data/collections/orders/{orderId}
//   bp_data/collections/disputes/{disputeId}
//
// Roles are stored in users/{uid}.role and are enforced server-side.
// The browser UI is NOT treated as a security boundary.

service cloud.firestore {
  match /databases/{database}/documents {

    function myDoc() {
      return get(/databases/$(database)/documents/bp_data/collections/users/$(request.auth.uid));
    }

    function myRole() {
      return myDoc().data.role;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && myRole() == 'admin'; }
    function isAgent() { return isSignedIn() && myRole() == 'agent'; }
    function isClient() { return isSignedIn() && myRole() == 'client'; }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validRole() {
      return request.resource.data.role in ['admin', 'agent', 'client'];
    }

    match /bp_data/collections {
      allow read, write: if false;
    }

    // Public exact username -> email/uid lookup used before Firebase Auth login.
    // No list access is granted, so the entire username table cannot be queried.
    match /bp_data/collections/usernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if hasOnly(['uid','email']) && (
        (isSignedIn() && request.resource.data.uid == request.auth.uid) ||
        isAdmin()
      );

      allow update: if false;
      allow delete: if isAdmin();
    }

    // USERS
    match /bp_data/collections/users/{uid} {
      // A user may read only their own profile; admin may read all profiles.
      allow get: if isSignedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      // Self-registration can create ONLY a client profile.
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.id == request.auth.uid
                    && request.resource.data.role == 'client'
                    && hasOnly(['id','uid','name','username','email','phone',
                                'location','role','orders_count','completed','created']);

      // Admin-created agent profile. The frontend uses a secondary Firebase
      // Auth instance so the primary admin session remains authenticated.
      allow create: if isAdmin()
                    && request.resource.data.uid == uid
                    && request.resource.data.id == uid
                    && request.resource.data.role == 'agent'
                    && hasOnly(['id','uid','name','username','email','phone',
                                'location','role','orders_count','completed','created']);

      // Agent may change only their own profile contact fields.
      allow update: if isAgent()
                    && uid == request.auth.uid
                    && changedOnly(['phone','location','email']);

      // Admin may update user profile/stat fields, but cannot create another
      // admin through the browser. The document ID/UID/created fields are immutable.
      allow update: if isAdmin()
                    && changedOnly(['name','username','email','phone','location',
                                    'role','orders_count','completed'])
                    && request.resource.data.role in ['admin','agent','client'];

      allow delete: if isAdmin();
    }

    // ORDERS
    match /bp_data/collections/orders/{orderId} {
      // Admin: all. Agent: assigned orders only. Client: own orders only.
      allow get: if isAdmin()
                 || (isAgent() && resource.data.agent_uid == request.auth.uid)
                 || (isClient() && resource.data.customer_id == request.auth.uid);

      // Query must be scoped by the same ownership field for non-admin users.
      allow list: if isAdmin()
                  || (isAgent() && resource.data.agent_uid == request.auth.uid)
                  || (isClient() && resource.data.customer_id == request.auth.uid);

      // Public landing-page order. Keep the anonymous document deliberately small.
      allow create: if request.auth == null
                    && request.resource.data.status == 'New'
                    && hasOnly(['id','display_num','customer_name','customer_phone',
                                'customer_location','seller_link','category','item_price',
                                'service_fee','description','seller_location','status',
                                'created_at','updated_at','source'])
                    && request.resource.data.source == 'public';

      // Authenticated client creates only their own new order.
      allow create: if isClient()
                    && request.resource.data.status == 'New'
                    && request.resource.data.customer_id == request.auth.uid
                    && !('agent_uid' in request.resource.data)
                    && hasOnly(['id','display_num','customer_id','customer_name',
                                'customer_phone','customer_location','seller_link','category',
                                'item_price','service_fee','description','seller_location',
                                'status','created_at','updated_at','source'])
                    && request.resource.data.source == 'client';

      // Admin creates a complete order on behalf of a customer.
      allow create: if isAdmin()
                    && hasOnly(['id','display_num','customer_id','customer_name',
                                'customer_phone','customer_location','seller_link','category',
                                'item_price','service_fee','description','seller_location',
                                'status','created_at','updated_at','agent_id','agent_uid',
                                'agent_name','agent_note','mpesa_ref','source']);

      // Admin can change workflow/assignment/payment metadata, but cannot
      // replace the document identity or original creation timestamp.
      allow update: if isAdmin()
                    && changedOnly(['display_num','customer_name','customer_phone',
                                    'customer_location','seller_link','category','item_price',
                                    'service_fee','description','seller_location','status',
                                    'agent_id','agent_uid','agent_name','agent_note','mpesa_ref',
                                    'rating','rated_at','updated_at','source']);

      // Agent can change only their workflow status/note/timestamp.
      allow update: if isAgent()
                    && resource.data.agent_uid == request.auth.uid
                    && changedOnly(['status','agent_note','updated_at'])
                    && request.resource.data.status in [
                      'Verified','Awaiting Payment','Paid','Delivered','Closed','Dispute'
                    ]
                    && request.resource.data.agent_uid == resource.data.agent_uid;

      // Client can rate only their own order, and cannot alter order data.
      allow update: if isClient()
                    && resource.data.customer_id == request.auth.uid
                    && changedOnly(['rating','rated_at'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow delete: if isAdmin();
    }

    // DISPUTES
    match /bp_data/collections/disputes/{disputeId} {
      allow get: if isAdmin()
                 || (isAgent() && resource.data.agent_uid == request.auth.uid);

      allow list: if isAdmin()
                  || (isAgent() && resource.data.agent_uid == request.auth.uid);

      // Admin may flag any order. Agent must flag a dispute for their own order.
      allow create: if isAdmin()
                    && request.resource.data.status == 'Open'
                    && request.resource.data.resolution == ''
                    && hasOnly(['id','order_id','agent_uid','customer_name','issue',
                                'status','resolution','created_at'])
                 || isAgent()
                    && request.resource.data.status == 'Open'
                    && request.resource.data.resolution == ''
                    && request.resource.data.agent_uid == request.auth.uid
                    && get(/databases/$(database)/documents/bp_data/collections/orders/$(request.resource.data.order_id)).data.agent_uid == request.auth.uid
                    && hasOnly(['id','order_id','agent_uid','customer_name','issue',
                                'status','resolution','created_at']);

      allow update: if isAdmin()
                    && changedOnly(['status','resolution'])
                    && request.resource.data.status == 'Resolved'
                    && request.resource.data.resolution.size() > 0;

      allow delete: if isAdmin();
    }

    // Everything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
